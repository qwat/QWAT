          <rule scalemindenom="1" description="toutes les vannes sauf organe réseau et vanne d'hydrant" filter=" COALESCE(&quot;schema_force_visible&quot;,&quot;valve_function_schema_visible&quot;)= 'true' &#xa;AND COALESCE( &quot;pipe_schema_force_visible&quot; , &quot;pipe_pipe_function_schema_visible&quot; )= 'true'" key="{7a025dab-c7fe-4c7c-9f0b-25a39f73abd8}" scalemaxdenom="100000" label="réseau">
            <rule filter="closed= 'true'" key="{edf1c363-d849-4700-82d0-34d494178d4d}" label="Fermée" symbol="0"/>
            <rule filter="&quot;fk_valve_type&quot; =6313" key="{6c48a279-b0d9-428b-819c-2fc5371720fe}" label="arrêt" symbol="1"/>
            <rule filter="fk_valve_function IN (6110,6112)" key="{8f1997aa-ce0e-467b-a33f-719c22255041}" label="vidange" symbol="2"/>
            <rule filter="fk_valve_function =6102" key="{3bf2a10c-e2fe-43c6-9287-c4055baec2a1}" label="ventouse" symbol="3"/>
            <rule filter="fk_valve_function NOT IN (6102,6110,6112) AND fk_valve_type NOT IN (6313) AND closed= 'false'" key="{6ea67572-5f92-462b-9419-18b0f15198f6}" label="vanne" symbol="4"/>
            <rule filter="distance(  $geometry,  make_point(  &quot;label_2_x&quot; ,  &quot;label_2_y&quot; ) ) / @map_scale  > 0.008" key="{ca9eb282-1517-4c0d-b3f2-2d60140a470a}" label="Lien vanne - étiquette" symbol="5"/>
          </rule>
