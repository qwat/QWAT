      <attributeEditorForm>
        <attributeEditorContainer visibilityExpressionEnabled="0" showLabel="1" name="Général" columnCount="1" groupBox="0" visibilityExpression="">
          <attributeEditorContainer visibilityExpressionEnabled="0" showLabel="0" name="" columnCount="2" groupBox="1" visibilityExpression="">
