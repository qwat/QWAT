                <property key="labeling/enabled" value="true"></property>
                <property key="labeling/fieldName" value=" replace( &quot;pipe_material_short_fr&quot;||' ','Inconnu ','')&#xA; ||&#xA; &quot;pipe_material_diameter&quot;&#xA; ||&#xA; CASE&#xA;WHEN  $scale  &lt; 501  AND  $length > 4 AND  &quot;fk_precision&quot; IN (1101,1103,1105) THEN ' imprécis'&#xA; ELSE ''&#xA; END&#xA;||&#xA; CASE&#xA;WHEN  $scale  &lt; 501  AND  $length > 4 THEN COALESCE('\n' ||&quot;year&quot;,'')&#xA;WHEN  $scale  >= 1000 THEN COALESCE(' ' ||&quot;year&quot;,'')&#xA; ELSE ''&#xA; END&#xA;||&#xA;CASE&#xA;WHEN  $scale  &lt;= 3000 THEN  COALESCE('\n'||  &quot;pipe_protection_value_fr&quot;, '')&#xA; ELSE ''&#xA;END&#xA;||&#xA;CASE&#xA;WHEN  $scale  &lt;= 6000  THEN  COALESCE(' ' ||&quot;label_1_text&quot;,'')&#xA; ELSE ''&#xA;END"></property>
