              <labeling type="rule-based">
                <rules>
                  <rule description="Matériau - diamètre- année" scalemaxdenom="3000" scalemindenom="1">
                    <settings>
                      <text-style blendMode="0" fieldName=" replace( &quot;pipe_material_short_fr&quot;||' ','Inconnu ','') ||  &quot;pipe_material_diameter&quot;&#xA;" fontCapitals="0" fontFamily="Arial" fontItalic="0" fontLetterSpacing="0" fontSize="8" fontSizeInMapUnits="0" fontSizeMapUnitMaxScale="0" fontSizeMapUnitMinScale="0" fontStrikeout="0" fontUnderline="0" fontWeight="50" fontWordSpacing="0" isExpression="1" namedStyle="Regular" previewBkgrdColor="#ffffff" textColor="0,80,255,255" textTransp="0"></text-style>
                      <text-format addDirectionSymbol="0" decimals="3" formatNumbers="0" leftDirectionSymbol="&lt;" multilineAlign="0" multilineHeight="1" placeDirectionSymbol="0" plussign="0" reverseDirectionSymbol="0" rightDirectionSymbol=">" wrapChar=""></text-format>
                      <text-buffer bufferBlendMode="0" bufferColor="255,255,255,255" bufferDraw="0" bufferJoinStyle="64" bufferNoFill="0" bufferSize="1" bufferSizeInMapUnits="0" bufferSizeMapUnitMaxScale="0" bufferSizeMapUnitMinScale="0" bufferTransp="0"></text-buffer>
                      <background shapeBlendMode="0" shapeBorderColor="128,128,128,255" shapeBorderWidth="0" shapeBorderWidthMapUnitMaxScale="0" shapeBorderWidthMapUnitMinScale="0" shapeBorderWidthUnits="1" shapeDraw="0" shapeFillColor="255,255,255,255" shapeJoinStyle="64" shapeOffsetMapUnitMaxScale="0" shapeOffsetMapUnitMinScale="0" shapeOffsetUnits="1" shapeOffsetX="0" shapeOffsetY="0" shapeRadiiMapUnitMaxScale="0" shapeRadiiMapUnitMinScale="0" shapeRadiiUnits="1" shapeRadiiX="0" shapeRadiiY="0" shapeRotation="0" shapeRotationType="0" shapeSVGFile="" shapeSizeMapUnitMaxScale="0" shapeSizeMapUnitMinScale="0" shapeSizeType="0" shapeSizeUnits="1" shapeSizeX="0" shapeSizeY="0" shapeTransparency="0" shapeType="0"></background>
                      <shadow shadowBlendMode="6" shadowColor="0,0,0,255" shadowDraw="0" shadowOffsetAngle="135" shadowOffsetDist="1" shadowOffsetGlobal="1" shadowOffsetMapUnitMaxScale="0" shadowOffsetMapUnitMinScale="0" shadowOffsetUnits="1" shadowRadius="1.5" shadowRadiusAlphaOnly="0" shadowRadiusMapUnitMaxScale="0" shadowRadiusMapUnitMinScale="0" shadowRadiusUnits="1" shadowScale="100" shadowTransparency="30" shadowUnder="0"></shadow>
                      <placement angleOffset="0" centroidInside="0" centroidWhole="0" dist="1" distInMapUnits="0" distMapUnitMaxScale="0" distMapUnitMinScale="0" fitInPolygonOnly="0" labelOffsetInMapUnits="1" labelOffsetMapUnitMaxScale="0" labelOffsetMapUnitMinScale="0" maxCurvedCharAngleIn="20" maxCurvedCharAngleOut="-20" offsetType="0" placement="2" placementFlags="14" predefinedPositionOrder="TR,TL,BR,BL,R,L,TSR,BSR" preserveRotation="1" priority="5" quadOffset="4" repeatDistance="0" repeatDistanceMapUnitMaxScale="0" repeatDistanceMapUnitMinScale="0" repeatDistanceUnit="1" xOffset="0" yOffset="0"></placement>
                      <rendering displayAll="0" fontLimitPixelSize="0" fontMaxPixelSize="10000" fontMinPixelSize="3" labelPerPart="0" limitNumLabels="0" maxNumLabels="2000" mergeLines="0" minFeatureSize="4" obstacle="1" obstacleFactor="1" obstacleType="0" scaleMax="10000000" scaleMin="1" scaleVisibility="0" upsidedownLabels="0" zIndex="0"></rendering>
                      <data-defined>
                        <Size active="true" expr="CASE WHEN $scale &lt; 3000 THEN 8 ELSE 6 END" field="" useExpr="true"></Size>
                        <Show active="true" expr="" field="label_1_visible" useExpr="false"></Show>
                        <AlwaysShow active="true" expr="CASE WHEN  &quot;label_1_visible&quot; = 2 THEN 1 ELSE 0 END" field="" useExpr="true"></AlwaysShow>
                      </data-defined>
                    </settings>
                  </rule>
                  <rule description="Imprécis" filter="&quot;fk_precision&quot; IN (1101,1103,1105)" scalemaxdenom="501" scalemindenom="1">
                    <settings>
