                  <Option name="name" type="QString" value=""></Option>
                  <Option name="properties" type="Map">
                    <Option name="angle" type="Map">
                      <Option name="active" type="bool" value="true"></Option>
                      <Option name="expression" type="QString" value="CASE WHEN hide_pipe = 1 THEN _pipe2_angle ELSE _pipe1_angle END"></Option>
                      <Option name="type" type="int" value="3"></Option>
                    </Option>
                    <Option name="offset" type="Map">
                      <Option name="active" type="bool" value="true"></Option>
                      <Option name="expression" type="QString" value="tostring(- 0.4 * tan($pi / 2 - $pi / 180 * (_pipe1_angle - _pipe2_angle))) || ',-1.0'"></Option>
