            <attributeEditorContainer visibilityExpressionEnabled="0" showLabel="0" name="General_col2" columnCount="1" groupBox="1" visibilityExpression="">
              <attributeEditorField showLabel="1" index="2" name="fk_function"/>
              <attributeEditorField showLabel="1" index="9" name="fk_status"/>
              <attributeEditorField showLabel="1" index="4" name="fk_material"/>
              <attributeEditorField showLabel="1" index="3" name="fk_installmethod"/>
              <attributeEditorField showLabel="1" index="7" name="fk_bedding"/>
              <attributeEditorField showLabel="1" index="8" name="fk_protection"/>
            </attributeEditorContainer>
            <attributeEditorContainer visibilityExpressionEnabled="0" showLabel="0" name="General_col1" columnCount="1" groupBox="1" visibilityExpression="">
              <attributeEditorField showLabel="1" index="0" name="id"/>
              <attributeEditorField showLabel="1" index="5" name="fk_distributor"/>
