                      <Option name="expression" type="QString" value="2 + 0.5 * abs(tan($pi / 2 - $pi / 180 * abs(_pipe1_angle - _pipe2_angle)))"></Option>
                      <Option name="type" type="int" value="3"></Option>
                    </Option>
                  </Option>
